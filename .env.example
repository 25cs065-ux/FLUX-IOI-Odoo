# Supabase (server-side — backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Access-token checks: secret only for legacy HS256 projects; JWKS is used otherwise
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase (browser-accessible — Next.js frontend)
# These are the same project as above; NEXT_PUBLIC_ prefix exposes them to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend URL (browser-accessible — used by the Next.js frontend api-client)
# Point to your running FastAPI instance, e.g. http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Backend (server-side)
BACKEND_URL=http://localhost:8000
JWT_SECRET=

# AI
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# Email (reset / verification / reminders)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=noreply@brightloop.test

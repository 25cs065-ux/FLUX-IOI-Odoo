# ---------------------------------------------------------------------------
# Environment variables — copy this to .env.local and fill in the values.
# Never commit .env.local or any file containing real credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase (browser-accessible — Next.js frontend)
# NEXT_PUBLIC_ prefix exposes these to the client bundle.
# Get these from the Supabase project dashboard → Settings → API.
# NEVER put the service-role key here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Backend API base URL (browser-accessible)
# NEXT_PUBLIC_API_URL is the canonical name used by api-client.ts.
# NEXT_PUBLIC_BACKEND_URL is accepted as a fallback for backward compatibility.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Supabase (server-side — backend only, never in the frontend)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Access-token checks: secret only for legacy HS256 projects; JWKS is used otherwise
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------------------
# NextAuth (may be obsolete — confirm with the team before using)
# The project now uses Supabase Auth directly.
# ---------------------------------------------------------------------------
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# Backend (server-side)
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
JWT_SECRET=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Email (reset / verification / reminders)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=noreply@brightloop.test
